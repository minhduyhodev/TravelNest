# Server
SERVER_PORT=8080

# Database - MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travelnest?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Bangkok
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Logging
APP_LOG_LEVEL_WEB=INFO
APP_LOG_LEVEL_SECURITY=INFO
APP_LOG_LEVEL_SQL=INFO
APP_LOG_LEVEL_SQL_BIND=INFO

# OpenAPI / Swagger
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# JWT
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Default Admin Seeder
APP_SEED_DEFAULT_ADMIN_ENABLED=true
APP_SEED_DEFAULT_ADMIN_EMAIL=admin@travelnest.local
APP_SEED_DEFAULT_ADMIN_PASSWORD=Admin@123
APP_SEED_DEFAULT_ADMIN_FULL_NAME=TravelNest Admin
APP_SEED_DEFAULT_ADMIN_PHONE=0900000000
APP_SEED_DEFAULT_ADMIN_PREFERRED_LANG=vi

# Auth Flow
APP_AUTH_RESET_OTP_EXPIRATION_MINUTES=15
APP_AUTH_DEBUG_RETURN_OTP=true

# Email
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@travelnest.local
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
VNPAY_RETURN_URL=

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_RETURN_URL=
MOMO_NOTIFY_URL=
